{
  "version": "science-v1",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "durationSeconds": {"min": 35, "ideal": 55, "max": 75}
  },
  "script": {
    "words": {"min": 90, "ideal": 140, "max": 190},
    "mainIdeas": {"min": 3, "max": 8},
    "oneCentralQuestion": true,
    "onePayoff": true,
    "technicalTermMustBeExplained": true,
    "hook": {
      "type": "direct-question",
      "headlineWordsMax": 10,
      "voiceWordsMax": 22,
      "mustContainQuestionMark": true,
      "firstFrameAnimationAllowed": false,
      "forbiddenMetaphors": ["unsichtbarer held", "geheime kraft"]
    }
  },
  "voice": {
    "speed": 1.1,
    "speedRange": {"min": 1.1, "max": 1.1},
    "silenceThresholdMs": 400,
    "keptPauseMs": 160,
    "silenceThresholdDb": -45,
    "loudness": {"integratedLufs": -16, "truePeakDb": -1.5, "loudnessRange": 11}
  },
  "visuals": {
    "policyVersion": "science-static-v1",
    "productionMode": "image-first-static",
    "beats": {"min": 6, "ideal": 10, "max": 16},
    "maximumTextOnlyScenesPerReel": 0,
    "frameZeroMustContainMainMotif": true,
    "generatedImageTextPolicy": "none",
    "coverUsesFirstScene": true,
    "separateThumbnailForbidden": true,
    "transitionPolicy": "hard-cut",
    "animationAllowed": false,
    "cameraMotionAllowed": false,
    "brandVisualStyleDefined": false
  },
  "textQuality": {
    "headlineWordsMax": 10,
    "bodyWordsMax": 24,
    "duplicatePhraseMinimumWords": 4,
    "vaguePhrases": ["das musst du wissen", "was bedeutet das konkret", "die wichtige frage", "der wichtigste punkt", "so funktioniert es", "hier ist die antwort", "ganz einfach erklärt"]
  },
  "captions": {
    "maximumStartDelayMs": 500,
    "maximumEndDriftMs": 500,
    "maximumGapMs": 1200,
    "maximumOverlapMs": 80,
    "perGroup": 4,
    "fontSize": 56,
    "bottom": 285,
    "maximumLines": 2,
    "color": "#ffffff",
    "highlightColor": null,
    "backgroundBox": false,
    "animated": false
  },
  "alignment": {"minimumWordMatchRatio": 0.82},
  "sound": {
    "musicBedAllowed": false,
    "maximumCuesPerScene": 1,
    "recommendedCuesPerReel": {"min": 0, "max": 5},
    "defaultCueVolume": 0.16,
    "maximumCueVolume": 0.3,
    "allowedRoles": ["sfx-accent", "sfx-warning", "sfx-reveal", "sfx-success", "sfx-soft-whoosh", "sfx-environment", "sfx-science"]
  },
  "imageAnalysis": {
    "portraitAspectMin": 0.48,
    "portraitAspectMax": 0.65,
    "minimumWidth": 720,
    "minimumHeight": 1280,
    "whiteBandMaximumRatio": 0.34,
    "fullImageWhiteMaximumRatio": 0.16,
    "backgroundClusterDistance": 28,
    "minimumBackgroundClusters": 2
  },
  "render": {
    "codec": "h264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioCodec": "aac",
    "audioBitrate": "192k",
    "x264Preset": "medium"
  },
  "renderQa": {
    "blackMinimumDurationSeconds": 0.35,
    "maximumInitialSilenceSeconds": 0.7,
    "maximumEndSilenceSeconds": 0.7,
    "integratedLufsMin": -18,
    "integratedLufsMax": -14,
    "truePeakMaximumDb": -1,
    "controlFrameCount": 10
  },
  "safety": {
    "hazardousTopicDisclaimerRequired": true,
    "riskyPhrases": [
      "unter spannung arbeiten",
      "sicherung überbrücken",
      "fi überbrücken",
      "schutzleiter entfernen",
      "mit bloßen händen prüfen",
      "chemikalien zusammenkippen ohne schutz",
      "giftiges gas einatmen",
      "radioaktive quelle öffnen"
    ],
    "dateSensitiveTerms": ["din vde", "dguv", "norm", "gesetz", "prüffrist", "grenzwert", "aktuell", "heute"]
  },
  "textLimits": {
    "kicker": 32,
    "headline": 90,
    "body": 180,
    "formula": 120,
    "outcome": 160,
    "label": 60,
    "step": 80,
    "voiceoverInstruction": 1200
  }
}
