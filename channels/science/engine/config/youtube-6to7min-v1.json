{
  "profile": "youtube-6to7min-v1",
  "status": "next-production-profile",
  "purpose": "Erster Schritt nach abgeschlossener 2-Minuten-Testphase",
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "aspectRatio": "16:9"
  },
  "durationSeconds": {
    "min": 360,
    "ideal": 390,
    "max": 420
  },
  "scriptWords": {
    "min": 850,
    "ideal": 975,
    "max": 1075
  },
  "visualBeats": {
    "min": 34,
    "ideal": 46,
    "max": 50
  },
  "narrativeStructure": [
    "hook",
    "context",
    "foundation",
    "mechanism",
    "deepening",
    "payoff"
  ],
  "storyRules": {
    "oneCentralQuestion": true,
    "explanationStartsEarly": true,
    "noGreetingOrLongIntro": true,
    "causeProcessResultPreferred": true,
    "noFactListPadding": true,
    "technicalTermsExplainedImmediately": true,
    "longerRuntimeMustComeFromMoreDepthNotRepetition": true,
    "rewriteWhenAdjacentBeatsWouldLookSimilar": true,
    "splitBeatWhenImageBudgetWouldBeExceeded": true
  },
  "visualSystem": {
    "styleName": "Technical Editorial Explainer 2.5D",
    "imageOnly": true,
    "oneFinalStaticImagePerBeat": true,
    "thumbnailCandidates": 3,
    "thumbnailSelectionIsOnlyManualStop": true,
    "imageProductionSteps": 5,
    "continueAutomaticallyAfterThumbnailSelection": true,
    "visibleImageLanguage": "de",
    "promptLanguage": "en",
    "sceneMetadataVisible": false,
    "thumbnailHeadlineMayLeakIntoScenes": false,
    "largeSceneHeadlineAllowed": false,
    "burnedInCaptions": false,
    "normalScenePreferredLabelsMax": 2,
    "normalSceneHardLabelsMax": 3,
    "normalScenePrimaryObjectsMax": 3,
    "sameCompositionMaxConsecutive": 1,
    "minimumDistinctVisualTypesPerVideo": 7,
    "coverExportDir": "05-export",
    "coverInVideoForbidden": true,
    "scene01MustBeIndependent": true,
    "visualBeatPacingSeconds": {
      "preferredMin": 5,
      "preferredMax": 9,
      "reviewIfLongerThan": 10
    },
    "extraBeatsWhenExplanationChanges": true,
    "diagramComparisonSummaryLabelsMax": 5,
    "panelsMax": 3,
    "arrowsMax": 4,
    "minimumTechnicalDiagramShare": 0.35,
    "annotationRule": "Prefer purposeful German labels, simple formulas and units, clear arrows and engineering schematics. No fake data or decorative legends."
  },
  "phase3": {
    "mayGenerateVisualAssets": false,
    "mayRegenerateVisualAssets": false,
    "maySearchExternalAssets": false,
    "maySubstituteMissingAssets": false,
    "missingAssetPolicy": "stop-and-report"
  },
  "transitionNote": "Dieses Profil wird für das erste 6–7-Minuten-Video aktiviert. Die 2-Minuten-Videos bleiben als Test-/Referenzphase erhalten."
}
