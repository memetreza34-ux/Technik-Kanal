  "captions": [
    {"fromFrame":6,"toFrame":70,"text":"Was macht der Schutzleiter?"},
    {"fromFrame":70,"toFrame":142,"text":"Er verbindet Metallteile mit dem Schutzsystem."},
    {"fromFrame":158,"toFrame":240,"text":"Bei Geräten der Schutzklasse eins"},
    {"fromFrame":240,"toFrame":322,"text":"ist das Metallgehäuse mit PE verbunden."},
    {"fromFrame":338,"toFrame":418,"text":"Im Normalbetrieb ist PE nicht"},
    {"fromFrame":418,"toFrame":502,"text":"für Betriebsstrom vorgesehen."},
    {"fromFrame":518,"toFrame":602,"text":"Bei einem Isolationsfehler kann"},
    {"fromFrame":602,"toFrame":682,"text":"das Gehäuse gefährliche Spannung führen."},
    {"fromFrame":698,"toFrame":782,"text":"Der Schutzleiter führt den Fehlerstrom"},
    {"fromFrame":782,"toFrame":862,"text":"über einen vorgesehenen Weg zurück."},
    {"fromFrame":878,"toFrame":960,"text":"Eine geeignete Schutzeinrichtung erkennt den Fehler"},
    {"fromFrame":960,"toFrame":1042,"text":"und trennt den Stromkreis."},
    {"fromFrame":1058,"toFrame":1140,"text":"Der Neutralleiter führt Betriebsstrom."},
    {"fromFrame":1140,"toFrame":1222,"text":"Der Schutzleiter dient dem Schutz."},
    {"fromFrame":1238,"toFrame":1336,"text":"Grün-Gelb kennzeichnet den Schutzleiter."},
    {"fromFrame":1336,"toFrame":1432,"text":"Diese Verbindung darf nicht verändert werden."},
    {"fromFrame":1448,"toFrame":1542,"text":"Beschädigtes Gerät ausstecken"},
    {"fromFrame":1542,"toFrame":1642,"text":"und fachgerecht prüfen lassen."}
  ],
