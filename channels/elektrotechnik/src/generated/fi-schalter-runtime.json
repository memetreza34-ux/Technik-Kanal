  "captions": [
    {"fromFrame":6,"toFrame":64,"text":"Was macht ein FI-Schalter?"},
    {"fromFrame":64,"toFrame":120,"text":"Er prüft, ob der Strom zurückkommt."},
    {"fromFrame":134,"toFrame":220,"text":"Technisch heißt er RCD."},
    {"fromFrame":220,"toFrame":301,"text":"Ein Summenstromwandler vergleicht beide Leiter."},
    {"fromFrame":317,"toFrame":390,"text":"Im Normalfall fließt derselbe Strom"},
    {"fromFrame":390,"toFrame":461,"text":"hin und zurück."},
    {"fromFrame":477,"toFrame":565,"text":"Bei einem Isolationsfehler kann Strom"},
    {"fromFrame":565,"toFrame":656,"text":"über den Schutzleiter zur Erde fließen."},
    {"fromFrame":672,"toFrame":722,"text":"Weniger Strom kommt zurück."},
    {"fromFrame":722,"toFrame":771,"text":"Diese Differenz heißt Fehlerstrom."},
    {"fromFrame":787,"toFrame":848,"text":"Der Wandler erkennt die Differenz"},
    {"fromFrame":848,"toFrame":909,"text":"und gibt ein Signal an den Auslöser."},
    {"fromFrame":925,"toFrame":982,"text":"Das Schaltschloss löst aus."},
    {"fromFrame":982,"toFrame":1047,"text":"Die Kontakte öffnen."},
    {"fromFrame":1063,"toFrame":1173,"text":"Häufig werden FI-Schalter bis 30 mA eingesetzt."},
    {"fromFrame":1189,"toFrame":1270,"text":"Der FI reagiert auf Fehlerstrom."},
    {"fromFrame":1270,"toFrame":1356,"text":"Der LS auf Überlast und Kurzschluss."},
    {"fromFrame":1372,"toFrame":1455,"text":"Nicht überbrücken oder ständig einschalten."},
    {"fromFrame":1455,"toFrame":1562,"text":"Geräte ausschalten und Stecker ziehen."},
    {"fromFrame":1562,"toFrame":1642,"text":"Ursache fachgerecht prüfen lassen."}
  ],
