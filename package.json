    "electrical:align":"node scripts/align-electrical-plan.mjs",
    "electrical:assets":"node scripts/run-electrical-with-folder-check.mjs scripts/ingest-electrical-assets.mjs",
    "electrical:media-search":"node scripts/search-electrical-public-media.mjs",
    "electrical:media-approve":"node scripts/approve-electrical-public-media.mjs",
    "electrical:public-media":"node scripts/fetch-electrical-public-media.mjs",
