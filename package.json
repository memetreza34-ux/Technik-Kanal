    "science:prepare":"node scripts/prepare_science_reel.mjs",
    "science:render":"node scripts/render_electrical_reel.mjs",
    "science:render-qa":"node scripts/qa_electrical_render.mjs",
    "science:finish":"node scripts/finish_electrical_reel.mjs",
    "science:validate":"node scripts/run-electrical-with-folder-check.mjs scripts/validate-electrical-project.mjs",
    "science:script-qa":"node scripts/run-electrical-script-qa.mjs",
    "science:creative-qa":"node scripts/run-electrical-creative-qa.mjs",
    "science:image-qa":"node scripts/check-electrical-image-appearance.mjs",
