{
  "name": "wissenschafts-kanal",
  "version": "2.0.0",
  "private": true,
  "description": "Produktionssystem für einen deutschsprachigen Faceless-Wissens- und Wissenschaftskanal",
  "workspaces": ["core", "channels/elektrotechnik"],
  "scripts": {
    "validate:science-template": "node scripts/validate-electrical-template.mjs",
    "validate:science-syntax": "node scripts/validate-electrical-syntax.mjs",
    "validate:science-system": "node scripts/validate-electrical-system.mjs",
    "validate:science-consistency": "node scripts/validate-electrical-consistency.mjs",
    "validate:science-visual-policy": "node scripts/test-electrical-visual-policy.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run typecheck",
    "studio": "npm run studio --workspace @science/channel",
    "smoke": "cd channels/elektrotechnik && npx remotion still src/index.ts ScienceReel /tmp/science-channel-smoke.png --frame=0",
    "render": "npm run science:render --",
    "voice:1.10": "node scripts/process_voiceover.mjs",
    "science:setup-local": "node scripts/setup_local_transcription.mjs",
    "science:transcribe": "node scripts/transcribe_electrical_voiceover.mjs",
    "science:new": "node scripts/safe-new-electrical-week-reel.mjs",
    "science:scaffold-test": "node scripts/test-electrical-scaffold-transaction.mjs",
    "science:e2e": "node scripts/test-electrical-e2e.mjs",
    "science:preflight": "node scripts/check-electrical-preproduction.mjs",
    "science:ready": "node scripts/check-electrical-production-readiness.mjs",
    "science:prepare": "node scripts/prepare_science_reel.mjs",
    "science:render": "node scripts/render_science_reel.mjs",
    "science:render-qa": "node scripts/qa_electrical_render.mjs",
    "science:finish": "node scripts/finish_science_reel.mjs",
    "science:validate": "node scripts/validate-electrical-project.mjs",
    "science:script-qa": "node scripts/run-electrical-script-qa.mjs",
    "science:creative-qa": "node scripts/run-electrical-creative-qa.mjs",
    "science:image-qa": "node scripts/check-electrical-image-appearance.mjs",
    "science:system-test": "npm test && npm run science:scaffold-test && npm run science:e2e && npm run smoke",
    "test": "npm run validate:science-syntax && npm run validate:science-template && npm run validate:science-system && npm run validate:science-consistency && npm run validate:science-visual-policy && npm run typecheck && vitest run"
  },
  "dependencies": {
    "@remotion/cli": "4.0.490",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.490",
    "sharp": "^0.35.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
