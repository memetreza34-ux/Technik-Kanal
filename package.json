    "youtube:verify": "node scripts/verify-render.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.490",
    "remotion": "4.0.490",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
