  "dependencies":{"@remotion/captions":"4.0.490","@remotion/cli":"4.0.490","@remotion/light-leaks":"4.0.490","@remotion/media-utils":"4.0.490","lucide-react":"^1.25.0","react":"19.2.4","react-dom":"19.2.4","remotion":"4.0.490","sharp":"^0.35.3","zod":"4.3.6"},
  "devDependencies":{"@types/react":"19.2.14","typescript":"5.9.3","vitest":"4.1.10"}
