{
  "name": "technik-kanal",
  "version": "2.0.0",
  "private": true,
  "description": "Produktionssystem für einen deutschsprachigen Faceless-Wissens- und Wissenschaftskanal",
  "workspaces": [
    "core",
    "channels/science"
  ],
  "scripts": {
    "validate:science-template": "node scripts/validate-science-template.mjs",
    "validate:science-syntax": "node scripts/validate-science-syntax.mjs",
    "validate:science-system": "node scripts/validate-science-system.mjs",
    "validate:science-consistency": "node scripts/validate-science-consistency.mjs",
    "validate:science-longform": "node scripts/test-science-longform.mjs",
    "validate:science-visual-policy": "node scripts/test-science-visual-policy.mjs",
    "validate:testphase-regressions": "node scripts/test-science-testphase-regressions.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "check": "npm run typecheck",
    "studio": "npm run studio --workspace @science/channel",
    "smoke": "cd channels/science && npx remotion still src/index.ts ScienceReel /tmp/science-channel-smoke.png --frame=0",
    "render": "npm run science:render --",
    "voice:1.10": "node scripts/process_voiceover.mjs",
    "science:setup-local": "node scripts/setup_local_transcription.mjs",
    "science:transcribe": "node scripts/transcribe_electrical_voiceover.mjs",
    "science:new": "node scripts/safe-new-science-reel.mjs",
    "science:flow-master": "node scripts/build-google-flow-master-prompt-safe.mjs",
    "science:scaffold-test": "node scripts/test-science-scaffold.mjs",
    "science:e2e": "node scripts/test-science-e2e.mjs",
    "science:preflight": "node scripts/science-preflight.mjs",
    "science:reference-qa": "node scripts/science-reference-qa.mjs",
    "science:ready": "node scripts/science-readiness.mjs",
    "science:prepare": "node scripts/prepare_science_reel.mjs",
    "science:render": "node scripts/render_science_reel.mjs",
    "science:render-qa": "node scripts/qa_science_render.mjs",
    "science:finish": "node scripts/finish_science_reel.mjs",
    "science:validate": "node scripts/validate-science-project.mjs",
    "science:script-qa": "node scripts/science-script-qa.mjs",
    "science:creative-qa": "node scripts/science-creative-qa.mjs",
    "science:image-qa": "node scripts/science-image-qa.mjs",
    "science:image-text-qa": "node scripts/science-image-text-qa.mjs",
    "science:title-check": "node scripts/science-title-check.mjs",
    "science:system-test": "npm test && npm run science:scaffold-test && npm run science:e2e && npm run smoke",
    "test": "npm run validate:science-syntax && npm run validate:science-template && npm run validate:science-system && npm run validate:science-consistency && npm run validate:science-visual-policy && npm run validate:testphase-regressions && npm run validate:science-learning && npm run validate:science-guardrails && npm run validate:science-phase1-handoff && npm run validate:science-flow-prompt && npm run validate:science-image-text && npm run validate:science-quality-v2 && npm run validate:science-motion-music && npm run validate:technik-simple && npm run validate:technik-cleanup && npm run typecheck && vitest run",
    "science:learn": "node scripts/science-learning.mjs",
    "validate:science-learning": "node scripts/test-science-learning.mjs",
    "science:phase1": "node scripts/finish-science-phase1.mjs",
    "science:phase1-handoff": "node scripts/science-phase1-handoff.mjs",
    "validate:science-phase1-handoff": "node scripts/test-science-phase1-handoff.mjs",
    "validate:science-flow-prompt": "node scripts/test-science-flow-prompt.mjs",
    "validate:science-image-text": "node scripts/test-science-image-text-qa.mjs",
    "validate:science-quality-v2": "node scripts/test-science-quality-v2.mjs",
    "validate:science-motion-music": "node scripts/test-science-motion-music.mjs",
    "technik:import": "node scripts/technik-import.mjs",
    "validate:technik-simple": "node scripts/test-technik-simple.mjs",
    "technik:cleanup": "node scripts/technik-cleanup.mjs",
    "validate:technik-cleanup": "node scripts/test-technik-cleanup.mjs",
    "science:asset-review": "node scripts/science-asset-review.mjs",
    "validate:science-guardrails": "node scripts/test-science-guardrails.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.490",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.490",
    "sharp": "^0.35.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
