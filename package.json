{
  "name":"elektrotechnik-kanal",
  "version":"1.0.0",
  "private":true,
  "description":"Eigenständiges Produktionssystem für den deutschsprachigen Elektrotechnik-Faceless-Kanal",
  "workspaces":["core","channels/elektrotechnik"],
  "scripts":{
    "validate:electrical-template":"node scripts/validate-electrical-template.mjs",
    "validate:electrical-syntax":"node scripts/validate-electrical-syntax.mjs",
    "validate:electrical-system":"node scripts/validate-electrical-system.mjs",
    "validate:electrical-consistency":"node scripts/validate-electrical-consistency.mjs",
    "validate:electrical-visual-policy":"node scripts/test-electrical-visual-policy.mjs",
    "typecheck":"node scripts/typecheck.mjs",
    "smoke":"cd channels/elektrotechnik && npx remotion still src/index.ts SicherungsReel /tmp/elektrotechnik-smoke.png --frame=0",
    "studio":"npm run studio --workspace @elektrotechnik/channel",
    "gallery":"cd channels/elektrotechnik && npx remotion studio src/layout-gallery-index.ts",
    "check":"npm run typecheck",
    "render":"npm run electrical:render --",
    "voice:1.10":"node scripts/process_voiceover.mjs",
    "electrical:setup-local":"node scripts/setup_local_transcription.mjs",
    "electrical:new":"node scripts/safe-new-electrical-week-reel.mjs",
    "electrical:scaffold-test":"node scripts/test-electrical-scaffold-transaction.mjs",
    "electrical:transcribe":"node scripts/transcribe_electrical_voiceover.mjs",
    "electrical:align":"node scripts/align-electrical-plan.mjs",
    "electrical:assets":"node scripts/run-electrical-with-folder-check.mjs scripts/ingest-electrical-assets.mjs",
    "electrical:media-search":"node scripts/search-electrical-public-media.mjs",
    "electrical:media-approve":"node scripts/approve-electrical-public-media.mjs",
    "electrical:public-media":"node scripts/fetch-electrical-public-media.mjs",
    "electrical:script-qa":"node scripts/run-electrical-script-qa.mjs",
    "electrical:creative-qa":"node scripts/run-electrical-creative-qa.mjs",
    "electrical:remotion-qa":"node scripts/check-electrical-remotion-quality.mjs",
    "electrical:image-qa":"node scripts/check-electrical-image-appearance.mjs",
    "electrical:callout-qa":"node scripts/check-electrical-callouts.mjs",
    "electrical:label-images":"node scripts/bake-electrical-image-labels.mjs",
    "electrical:content-package":"node scripts/run-electrical-with-folder-check.mjs scripts/check-electrical-content-package.mjs",
    "electrical:preflight":"node scripts/check-electrical-preproduction.mjs",
    "electrical:content-ready":"node scripts/check-electrical-preproduction.mjs",
    "electrical:qa":"node scripts/run-electrical-qa-from-project.mjs",
    "electrical:ready":"node scripts/check-electrical-production-readiness.mjs",
    "electrical:validate":"node scripts/run-electrical-with-folder-check.mjs scripts/validate-electrical-project.mjs",
    "electrical:prepare":"node scripts/prepare_electrical_reel.mjs",
    "electrical:render":"node scripts/render_electrical_reel.mjs",
    "electrical:render-qa":"node scripts/qa_electrical_render.mjs",
    "electrical:export":"node scripts/run-electrical-with-folder-check.mjs scripts/export-electrical-deliverables.mjs",
    "electrical:finish":"node scripts/finish_electrical_reel.mjs",
    "electrical:e2e":"node scripts/test-electrical-e2e.mjs",
    "electrical:system-test":"npm test && npm run electrical:scaffold-test && npm run electrical:e2e && npm run smoke",
    "elektro:setup-local":"npm run electrical:setup-local --",
    "elektro:transcribe":"npm run electrical:transcribe --",
    "elektro:prepare":"npm run electrical:prepare --",
    "elektro:render":"npm run electrical:render --",
    "elektro:qa":"npm run electrical:render-qa --",
    "elektro:finish":"npm run electrical:finish --",
    "test":"npm run validate:electrical-syntax && npm run validate:electrical-template && npm run validate:electrical-system && npm run validate:electrical-consistency && npm run validate:electrical-visual-policy && npm run typecheck && vitest run"
  },
  "dependencies":{"@remotion/captions":"4.0.490","@remotion/cli":"4.0.490","@remotion/light-leaks":"4.0.490","@remotion/media-utils":"4.0.490","lucide-react":"^1.25.0","react":"19.2.4","react-dom":"19.2.4","remotion":"4.0.490","sharp":"^0.35.3","zod":"4.3.6"},
  "devDependencies":{"@types/react":"19.2.14","typescript":"5.9.3","vitest":"4.1.10"}
}
