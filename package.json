    "electrical:content-package":"node scripts/run-electrical-with-folder-check.mjs scripts/check-electrical-content-package.mjs",
    "electrical:preflight":"npm run science:preflight --",
    "electrical:content-ready":"npm run science:preflight --",
    "electrical:qa":"node scripts/run-electrical-qa-from-project.mjs",
    "electrical:ready":"npm run science:ready --",
    "electrical:validate":"npm run science:validate --",
    "electrical:prepare":"npm run science:prepare --",
    "electrical:render":"npm run science:render --",
    "electrical:render-qa":"npm run science:render-qa --",
